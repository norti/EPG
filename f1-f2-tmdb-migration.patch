+    conn.execute_batch(
+        "CREATE TABLE IF NOT EXISTS trakt_show_fp (
+            show_trakt_id INTEGER PRIMARY KEY,
+            seen_fp       TEXT,
+            synced_fp     TEXT,
+            updated_at    TEXT NOT NULL
+        );",
+    )?;
+    Ok(())
