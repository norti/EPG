{
  "identifier": "epgviewer.nrt",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http: epgimg:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    },
    "windows": [
      {
        "title": "EPG Viewer",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "norti",
    "copyright": "Copyright © 2026 norti",
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOERGMjkwMTI3MzIxOUIKUldTYklYTVNrUEtOd01XZUdjaGpueENpYWdZREl5a1M5MFpPKzhaWGlWV2o2aDNOR1kyL285R1oK",
      "endpoints": ["https://epg.norti.workers.dev/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
